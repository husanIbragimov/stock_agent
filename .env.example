# Telegram bot sozlamalari
# 1. Telegram'da @BotFather ga yozib /newbot orqali bot yarating, tokenni shu yerga qo'ying.
# 2. Botga shaxsiy xabar yuboring (masalan "salom"), keyin
#    https://api.telegram.org/bot<TOKEN>/getUpdates manzilini brauzerda oching va
#    "chat":{"id": ...} qiymatini toping — shu raqam TELEGRAM_CHAT_ID bo'ladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ixtiyoriy: xabarlarni konsolga ham yozib turish uchun
LOG_LEVEL=INFO

# Ixtiyoriy: SQLite ma'lumotlar bazasi fayli qayerda saqlansin
DB_PATH=./data/agent.db
